#!/usr/bin/env python3
"""CLI entry point for the procedural capability graph."""

from __future__ import annotations

import os
import sys

sys.path.insert(0, os.path.join(os.path.dirname(__file__), "_lib"))
from cli import REPO_ROOT, quiet_logs

if str(REPO_ROOT) not in sys.path:
    sys.path.insert(0, str(REPO_ROOT))

quiet_logs()

from src.capability_graph.cli import main


if __name__ == "__main__":
    sys.exit(main())

