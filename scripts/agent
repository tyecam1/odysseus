#!/usr/bin/env python3
"""agent — Aoteru estate operator bay front door.

P1 (docs/aoteru-estate-implementation-plan.md "P1 - Estate registry +
operator bay"): read-only discovery. P3 ("P3 - Parking + remote native
execution", lab-first per docs/aoteru-lab-first-continuation.md) adds
parking leases. P5 (execution contract's "Laptop Claude routing skill"
binding rule, lab-first) adds `agent claude` dispatch — all in the same
file rather than a second launcher/config system.

    agent status                       # live host + registry resolution, JSON
    agent where                        # current repo's registry identity + lease
    agent sync                         # regenerate the disposable bay + workspace bootstrap
    agent park <repo_id> [--host ID]   # acquire a write lease (fails closed on dirty/conflict)
    agent release <repo_id> [--host ID]
    agent claude <auto|lab|home> "<task>" [--repo ID]   # resolve + dispatch, fails truthfully if unreachable
    agent claude where                                    # active logical sessions

Reads the four canonical registries in config/*.yaml (committed, no secrets,
no physical paths) plus a host-local file at ~/.aoteru/config.local.json
(never committed — see plan section 3.1) that maps root variables like
AI_ROOT/PHD_ROOT/HOUSEHOLD_ROOT to real paths on *this* host. A repo whose
root variable isn't set, or whose resolved path doesn't exist, is reported
as unresolved — never guessed.
"""
from __future__ import annotations
import sys
import os, sys
sys.path.insert(0, os.path.join(os.path.dirname(__file__), "_lib"))
from cli import quiet_logs, emit, fail, common_parser, run, REPO_ROOT as _REPO_ROOT
quiet_logs()

import argparse
import json
import platform
import re
import socket
import sys
from datetime import datetime, timezone
from pathlib import Path

try:
    import yaml
except ModuleNotFoundError as e:
    sys.stderr.write(f"error: {e}\nhint: pip install -r requirements.txt (PyYAML)\n")
    sys.exit(2)

_CONFIG_DIR = _REPO_ROOT / "config"
_AOTERU_HOME = Path.home() / ".aoteru"
_HOST_LOCAL_PATH = _AOTERU_HOME / "config.local.json"
_BAY_DIR = Path.home() / "aoteru-bay"

_ROOT_VARS = ("AI_ROOT", "PHD_ROOT", "HOUSEHOLD_ROOT")


def _load_yaml(name: str):
    path = _CONFIG_DIR / f"{name}.yaml"
    if not path.exists():
        fail(f"missing registry: {path}")
    with path.open() as f:
        return yaml.safe_load(f) or {}


def _load_host_local() -> dict:
    """Host-local root/path config. Generated on first use, never committed.
    AI_ROOT defaults to this repo's parent dir since the odysseus family
    lives as siblings under one projects root on every host seen so far;
    PHD_ROOT/HOUSEHOLD_ROOT are left unset — inferring those would be a
    guess this tool must not make."""
    if _HOST_LOCAL_PATH.exists():
        try:
            return json.loads(_HOST_LOCAL_PATH.read_text())
        except (json.JSONDecodeError, OSError):
            pass
    cfg = {
        "host_id": None,
        "AI_ROOT": str(_REPO_ROOT.parent),
        "PHD_ROOT": None,
        "HOUSEHOLD_ROOT": None,
    }
    _AOTERU_HOME.mkdir(parents=True, exist_ok=True)
    _HOST_LOCAL_PATH.write_text(json.dumps(cfg, indent=2) + "\n")
    return cfg


_VAR_RE = re.compile(r"\$\{(\w+)\}")


def _resolve_path(template: str, host_local: dict) -> dict:
    """Resolve a `${ROOT_VAR}/...` template against host-local config.
    Returns a dict describing resolution status rather than a bare path or
    None, so callers never have to guess why something didn't resolve."""
    m = _VAR_RE.search(template)
    if not m:
        return {"status": "resolved", "path": template, "exists": Path(template).exists()}
    var = m.group(1)
    root = host_local.get(var)
    if not root:
        return {"status": f"unresolved: {var} not set in {_HOST_LOCAL_PATH}", "path": None, "exists": False}
    resolved = template.replace(f"${{{var}}}", root)
    exists = Path(resolved).exists()
    return {
        "status": "resolved" if exists else "root-set-but-path-missing",
        "path": resolved,
        "exists": exists,
    }


def _live_host_inventory() -> dict:
    disk = None
    try:
        import shutil as _shutil
        total, used, free = _shutil.disk_usage(str(_REPO_ROOT))
        disk = {"total_gb": round(total / 2**30, 1), "free_gb": round(free / 2**30, 1)}
    except OSError:
        pass
    mem_total_gb = None
    try:
        with open("/proc/meminfo") as f:
            for line in f:
                if line.startswith("MemTotal:"):
                    mem_total_gb = round(int(line.split()[1]) / 2**20, 1)
                    break
    except OSError:
        pass
    return {
        "hostname": socket.gethostname(),
        "os": platform.platform(),
        "cpu_count": os.cpu_count(),
        "mem_total_gb": mem_total_gb,
        "disk_at_repo_root": disk,
    }


def _resolve_repos(host_local: dict) -> list[dict]:
    repos = _load_yaml("repositories").get("repos", [])
    out = []
    for r in repos:
        res = _resolve_path(r["path"], host_local)
        out.append({
            "id": r["id"],
            "authority": r.get("authority"),
            "canonical": bool(r.get("canonical")),
            "role": r.get("role"),
            **res,
        })
    return out


def _resolve_current_host(estate: dict, hostname: str) -> dict | None:
    for h in estate.get("hosts", []):
        if h.get("hostname") == hostname:
            return h
    return None


def _repo_by_id(repos: list[dict], repo_id: str) -> dict | None:
    return next((r for r in repos if r["id"] == repo_id), None)


def _git_is_clean(path: str) -> tuple[bool, str]:
    """Fail closed: anything but a clean `git status --porcelain` (including
    the command itself failing) is treated as dirty."""
    import subprocess
    try:
        out = subprocess.run(
            ["git", "-C", path, "status", "--porcelain"],
            capture_output=True, text=True, timeout=15,
        )
    except (OSError, subprocess.TimeoutExpired) as e:
        return False, f"git status failed: {e}"
    if out.returncode != 0:
        return False, out.stderr.strip() or "git status failed"
    if out.stdout.strip():
        return False, "working tree has uncommitted changes"
    return True, ""


def _lease_db():
    """Import lazily — the CLI must still work (status/where/sync) even if
    the app's dependencies aren't installed in whatever environment invokes
    it; only park/release/heartbeat need the ORM."""
    try:
        from core.database import get_db_session, ParkLease, utcnow_naive
    except ModuleNotFoundError as e:
        fail(f"{e}\nhint: run from a venv with the app's requirements installed (park/release need core.database).")
    return get_db_session, ParkLease, utcnow_naive


def cmd_park(args):
    host_local = _load_host_local()
    estate = _load_yaml("estate")
    repos = _resolve_repos(host_local)
    repo = _repo_by_id(repos, args.repo_id)
    if repo is None:
        fail(f"unknown repo id {args.repo_id!r} (see config/repositories.yaml)")
    if not repo["exists"]:
        fail(f"{args.repo_id!r} does not resolve on this host: {repo['status']}")

    live_hostname = socket.gethostname()
    this_host = _resolve_current_host(estate, live_hostname)
    host_id = args.host or (this_host["id"] if this_host else None)
    if host_id is None:
        fail("could not determine host id — pass --host explicitly (this host isn't in config/estate.yaml)")
    if host_id != (this_host["id"] if this_host else None):
        fail(
            f"--host {host_id!r} is not this machine ({live_hostname!r}) — "
            f"parking a repo on a host this session isn't running on requires that host's own "
            f"session/operator to acquire the lease, not a remote insert from here."
        )

    clean, reason = _git_is_clean(repo["path"])
    if not clean:
        fail(f"refusing to park {args.repo_id!r}: {reason} (fail-closed — commit/stash first)")

    get_db_session, ParkLease, _ = _lease_db()
    import uuid
    from sqlalchemy.exc import IntegrityError

    lease_id = str(uuid.uuid4())
    try:
        with get_db_session() as db:
            lease = ParkLease(
                id=lease_id,
                repo_id=args.repo_id,
                host_id=host_id,
                worktree_path=repo["path"],
                branch=args.branch,
                session_id=args.session,
                allowed_write_scope="repo",
                status="active",
            )
            db.add(lease)
    except IntegrityError:
        fail(f"{args.repo_id!r} is already parked (active lease exists) — release it first")

    emit({
        "ok": True,
        "lease_id": lease_id,
        "repo_id": args.repo_id,
        "host_id": host_id,
        "worktree_path": repo["path"],
        "branch": args.branch,
        "session_id": args.session,
    }, args)


def cmd_release(args):
    get_db_session, ParkLease, utcnow_naive = _lease_db()
    host_local = _load_host_local()
    estate = _load_yaml("estate")
    live_hostname = socket.gethostname()
    this_host = _resolve_current_host(estate, live_hostname)
    host_id = args.host or (this_host["id"] if this_host else None)

    with get_db_session() as db:
        q = db.query(ParkLease).filter(ParkLease.repo_id == args.repo_id, ParkLease.status == "active")
        if host_id:
            q = q.filter(ParkLease.host_id == host_id)
        lease = q.first()
        if lease is None:
            fail(f"no active lease for {args.repo_id!r}" + (f" on {host_id!r}" if host_id else ""))
        lease.status = "released"
        lease.released_at = utcnow_naive()
        released = {"lease_id": lease.id, "repo_id": lease.repo_id, "host_id": lease.host_id}

    emit({"ok": True, **released}, args)


def _session_db():
    try:
        from core.database import get_db_session, LogicalSession
    except ModuleNotFoundError as e:
        fail(f"{e}\nhint: run from a venv with the app's requirements installed (agent claude needs core.database).")
    return get_db_session, LogicalSession


def _host_by_role(estate: dict, role: str) -> dict | None:
    return next((h for h in estate.get("hosts", []) if h.get("role") == role), None)


def _resolve_target_host(mode: str, estate: dict, live_hostname: str) -> dict | None:
    if mode == "lab":
        return _host_by_role(estate, "lab")
    if mode == "home":
        return _host_by_role(estate, "home")
    # auto: prefer this host if it's registered at all, else the first
    # registered worker role (lab before home — lab is what's actually
    # verified reachable per the lab-first contract).
    this_host = _resolve_current_host(estate, live_hostname)
    if this_host is not None:
        return this_host
    return _host_by_role(estate, "lab") or _host_by_role(estate, "home")


def _host_reachable(host: dict, live_hostname: str) -> tuple[bool, str]:
    """No assumptions: this host is reachable by construction; anything
    else needs a real, bounded network probe. `home` genuinely failing
    this check (not a tailnet member, or SSH unreachable) is the contract's
    "home must fail truthfully as unavailable" requirement, not a bug."""
    if host.get("hostname") == live_hostname:
        return True, "this host"
    if not host.get("tailscale"):
        return False, f"{host['id']!r} is not a tailnet member"
    dns = host.get("tailscale_dns")
    if not dns:
        return False, f"{host['id']!r} has no tailscale_dns recorded in config/estate.yaml"
    s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    s.settimeout(4)
    try:
        s.connect((dns, 22))
        return True, "SSH port reachable over the tailnet"
    except OSError as e:
        return False, f"unreachable: {e}"
    finally:
        s.close()


def cmd_claude(args):
    if args.mode != "where" and not args.task:
        fail(f"agent claude {args.mode} requires a task string")

    if args.mode == "where":
        get_db_session, LogicalSession = _session_db()
        with get_db_session() as db:
            rows = db.query(LogicalSession).filter(LogicalSession.status == "active").all()
            sessions = [{
                "id": r.id, "host_id": r.host_id, "repo_id": r.repo_id, "engine": r.engine,
                "claude_session_id": r.claude_session_id, "last_result": r.last_result,
            } for r in rows]
        emit({"active_sessions": sessions}, args)
        return

    host_local = _load_host_local()
    estate = _load_yaml("estate")
    live_hostname = socket.gethostname()

    host = _resolve_target_host(args.mode, estate, live_hostname)
    if host is None:
        fail(f"no host registered for mode {args.mode!r} — see config/estate.yaml")

    reachable, reason = _host_reachable(host, live_hostname)
    if not reachable:
        fail(f"{args.mode} ({host['id']}) is unavailable: {reason}")

    repos = _resolve_repos(host_local)
    repo_id = args.repo
    if repo_id is None:
        cwd = str(Path.cwd().resolve())
        current = next((r for r in repos if r.get("path") and Path(r["path"]).resolve() == Path(cwd)), None)
        repo_id = current["id"] if current else None
    repo = _repo_by_id(repos, repo_id) if repo_id else None

    if host.get("hostname") != live_hostname:
        # Remote dispatch would SSH into `host` and launch claude there.
        # Not implemented from this session: lab-first has no second
        # reachable worker to actually dispatch to yet (see
        # docs/aoteru-estate-p5-evidence.md) — failing truthfully rather
        # than pretending a remote launch happened.
        fail(
            f"{args.mode} would dispatch to {host['id']} via SSH — not implemented from "
            f"this session (no second reachable worker; see docs/aoteru-estate-p5-evidence.md)"
        )

    import shutil as _shutil
    import uuid
    claude_bin = _shutil.which("claude")

    get_db_session, LogicalSession = _session_db()
    session_id = str(uuid.uuid4())
    with get_db_session() as db:
        db.add(LogicalSession(
            id=session_id, host_id=host["id"], repo_id=repo_id,
            worktree_path=repo["path"] if repo else None,
            engine="claude", status="active",
        ))

    if claude_bin is None:
        emit({
            "ok": False, "mode": args.mode, "host_id": host["id"], "session_id": session_id,
            "repo_id": repo_id, "task": args.task,
            "error": "claude CLI is not installed on this host — cannot launch a native session",
        }, args)
        return

    # claude_bin present: launch non-interactively in the resolved
    # worktree. Unreachable in this environment (no `claude` binary here —
    # see evidence doc) so deliberately not implemented speculatively;
    # the interface above (session already recorded, repo/host already
    # resolved) is what a future session with the binary present extends,
    # not redesigns.
    fail("claude CLI found but native launch is not yet implemented — session recorded, extend here")


def cmd_status(args):
    host_local = _load_host_local()
    live = _live_host_inventory()
    estate = _load_yaml("estate")
    models = _load_yaml("models")
    memory_sources = _load_yaml("memory-sources")

    repos = _resolve_repos(host_local)
    this_host = _resolve_current_host(estate, live["hostname"])

    emit({
        "host": {
            **live,
            "registered_as": this_host["id"] if this_host else None,
            "role": this_host.get("role") if this_host else None,
            "registered": this_host is not None,
        },
        "repos": repos,
        "services": [
            {"id": s["id"], "description": s.get("description"), "live": s.get("endpoint") is not None}
            for s in estate.get("services", [])
        ],
        "capabilities": [
            {"alias": c["alias"], "bound": c.get("binding") is not None}
            for c in models.get("capabilities", [])
        ],
        "memory_sources": [
            {"id": s["id"], "status": s.get("status")} for s in memory_sources.get("sources", [])
        ],
        "host_local_config": str(_HOST_LOCAL_PATH),
    }, args)


def cmd_where(args):
    host_local = _load_host_local()
    repos = _resolve_repos(host_local)
    cwd = str(Path.cwd().resolve())
    current = next((r for r in repos if r.get("path") and Path(r["path"]).resolve() == Path(cwd)), None)
    if current is None and (_REPO_ROOT / ".git").exists():
        # Fall back to identifying by repo root when cwd is a subdirectory.
        current = next((r for r in repos if r.get("path") and Path(r["path"]).resolve() == _REPO_ROOT.resolve()), None)

    lease = None
    if current is not None:
        try:
            from core.database import get_db_session, ParkLease
        except ModuleNotFoundError:
            lease = "unavailable (core.database not importable from this environment)"
        else:
            with get_db_session() as db:
                row = db.query(ParkLease).filter(
                    ParkLease.repo_id == current["id"], ParkLease.status == "active"
                ).first()
                if row is not None:
                    lease = {
                        "lease_id": row.id, "host_id": row.host_id,
                        "branch": row.branch, "session_id": row.session_id,
                        "heartbeat_at": row.heartbeat_at.isoformat() if row.heartbeat_at else None,
                    }

    emit({
        "cwd": cwd,
        "registered_repo": current["id"] if current else None,
        "lease": lease,
    }, args)


def _bay_claude_md() -> str:
    return (
        "<!-- generated by `agent sync` — do not hand-edit, re-run sync instead -->\n"
        "You are speaking as **Aoteru**.\n\n"
        "For live estate/host/repo/service state, use the user-scoped "
        "`estate-control` MCP; for personal memory, use `aoteru-memory`. "
        "Never infer a host, path, or model from this file's prose — it is "
        "a pointer, not a source of truth.\n\n"
        "Inside a specific repo, that repo's own CLAUDE.md/AGENTS.md and "
        "rules take precedence over anything here.\n\n"
        "Before any mutation in a registered repo, run `agent park` first.\n"
    )


def _workspace_claude_md() -> str:
    return (
        "<!-- generated by `agent sync` — do not hand-edit, re-run sync instead -->\n"
        "You are speaking as **Aoteru**, operating inside the estate "
        "workspace. Each cloned repo below carries its own authority — obey "
        "its local CLAUDE.md/AGENTS.md once you're inside it.\n\n"
        "Resolve hosts/repos/services by logical ID via `agent status` / "
        "`agent where`; do not hardcode paths from this file.\n\n"
        "Mutation requires an active parking lease — run `agent park <repo_id>` "
        "first; it fails closed on a dirty tree or a conflicting lease.\n"
    )


def _estate_routing_skill_md() -> str:
    return (
        "---\n"
        "name: aoteru-estate-routing\n"
        "description: Route a task to an Aoteru estate worker (lab/home) "
        "via `agent claude auto|lab|home \"<task>\"`, or list active "
        "sessions via `agent claude where`. Use when the user wants work "
        "executed on a specific estate machine instead of locally.\n"
        "---\n\n"
        "Ergonomic wrapper over the existing `agent` CLI / estate registry "
        "— never a second router or authority. Never hardcode a hostname, "
        "path, repo map, model name, or credential here; always resolve "
        "through the live `agent` command's own output.\n\n"
        "- `agent claude auto \"<task>\" [--repo <id>]` — resolve the best "
        "available host from live estate state.\n"
        "- `agent claude lab \"<task>\" [--repo <id>]` — dispatch to the lab worker.\n"
        "- `agent claude home \"<task>\" [--repo <id>]` — dispatch to the home "
        "worker. It fails truthfully when home is unavailable — report that "
        "failure plainly, never invent a result.\n"
        "- `agent claude where` — report active logical sessions.\n\n"
        "Read the JSON the command prints. On `\"ok\": false` or a nonzero "
        "exit, report the exact error — do not retry silently and do not "
        "fabricate a successful outcome.\n\n"
        "Once inside a resolved repo/worktree, that repo's own "
        "CLAUDE.md/AGENTS.md and rules take precedence over this skill's "
        "own convenience.\n"
    )


def cmd_sync(args):
    host_local = _load_host_local()
    repos = _resolve_repos(host_local)

    _AOTERU_HOME.mkdir(parents=True, exist_ok=True)
    cache = {
        "generated_at": datetime.now(timezone.utc).isoformat(),
        "repos": repos,
    }
    (_AOTERU_HOME / "estate-cache.json").write_text(json.dumps(cache, indent=2) + "\n")

    _BAY_DIR.mkdir(parents=True, exist_ok=True)
    bay_md = _bay_claude_md()
    (_BAY_DIR / "CLAUDE.md").write_text(bay_md)

    written = ["estate-cache.json", str(_BAY_DIR / "CLAUDE.md")]
    ai_root = host_local.get("AI_ROOT")
    if ai_root and Path(ai_root).exists():
        workspace = Path(ai_root) / "workspace"
        workspace.mkdir(parents=True, exist_ok=True)
        ws_md = _workspace_claude_md()
        (workspace / "CLAUDE.md").write_text(ws_md)
        written.append(str(workspace / "CLAUDE.md"))

    skill_dir = Path.home() / ".claude" / "skills" / "aoteru-estate-routing"
    skill_dir.mkdir(parents=True, exist_ok=True)
    (skill_dir / "SKILL.md").write_text(_estate_routing_skill_md())
    written.append(str(skill_dir / "SKILL.md"))

    bay_lines = len(bay_md.splitlines())
    emit({
        "ok": True,
        "written": written,
        "bay_claude_md_lines": bay_lines,
        "under_30_lines": bay_lines < 30,
    }, args)


def _build_parser():
    p = common_parser("agent", "Aoteru estate operator bay front door (P1: read-only discovery).")
    parent = p._common_parents[0]
    sub = p.add_subparsers(dest="cmd", required=True)

    ps = sub.add_parser("status", parents=[parent], help="live host + registry resolution")
    ps.set_defaults(func=cmd_status)

    pw = sub.add_parser("where", parents=[parent], help="current repo's registry identity + lease")
    pw.set_defaults(func=cmd_where)

    psy = sub.add_parser("sync", parents=[parent], help="regenerate disposable bay + workspace bootstrap")
    psy.set_defaults(func=cmd_sync)

    pp = sub.add_parser("park", parents=[parent], help="acquire a write lease on a registered repo")
    pp.add_argument("repo_id")
    pp.add_argument("--host", default=None, help="host id from config/estate.yaml (default: this host)")
    pp.add_argument("--branch", default=None)
    pp.add_argument("--session", default=None)
    pp.set_defaults(func=cmd_park)

    pr = sub.add_parser("release", parents=[parent], help="release an active lease on a registered repo")
    pr.add_argument("repo_id")
    pr.add_argument("--host", default=None)
    pr.set_defaults(func=cmd_release)

    pc = sub.add_parser("claude", parents=[parent], help="resolve + dispatch a Claude session (auto/lab/home/where)")
    pc.add_argument("mode", choices=["auto", "lab", "home", "where"])
    pc.add_argument("task", nargs="?", default=None)
    pc.add_argument("--repo", default=None)
    pc.set_defaults(func=cmd_claude)

    return p


if __name__ == "__main__":
    sys.exit(run(_build_parser()))
